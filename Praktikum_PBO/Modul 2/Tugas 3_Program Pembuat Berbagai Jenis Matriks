class Matriks:
    def __init__(self, baris=0, kolom=0):
        self.__baris = baris
        self.__kolom = kolom
        self.__data = []

    @property
    def baris(self):
        return self.__baris
    @baris.setter
    def baris(self, baris):
        self.__baris = baris
    @property
    def kolom(self):
        return self.__kolom
    @kolom.setter
    def kolom(self, kolom):
        self.__kolom = kolom
    @property
    def data(self):
        return self.__data
    @data.setter
    def data(self, data):
        self.__data = data

    def Nol(self, baris, kolom):
        self.__baris = baris
        self.__kolom = kolom
        self.__data = [[0 for j in range(kolom)] for i in range(baris)]
        return self
    def Baris(self, elemen):
        self.__baris = 1
        self.__kolom = len(elemen)
        self.__data = [elemen.copy()]
        return self
    def Kolom(self, elemen):
        self.__baris = len(elemen)
        self.__kolom = 1
        self.__data = [[e] for e in elemen]
        return self
    def Persegi(self, n):
        self.__baris = n
        self.__kolom = n
        self.__data = [[0 for j in range(n)] for i in range(n)]
        return self
    def Diagonal(self, nilai):
        n = len(nilai)
        self.__baris = n
        self.__kolom = n
        self.__data = [[0 for j in range(n)] for i in range(n)]
        for i in range(n):
            self.__data[i][i] = nilai[i]
        return self
    def SegitigaAtas(self, n):
        self.__baris = n
        self.__kolom = n
        self.__data = [[0 for j in range(n)] for i in range(n)]
        for i in range(n):
            for j in range(i, n):
                self.__data[i][j] = 1
        return self
    def SegitigaBawah(self, n):
        self.__baris = n
        self.__kolom = n
        self.__data = [[0 for j in range(n)] for i in range(n)]
        for i in range(n):
            for j in range(0, i+1):
                self.__data[i][j] = 1
        return self
    def Identitas(self, n):
        self.__baris = n
        self.__kolom = n
        self.__data = [[0 for j in range(n)] for i in range(n)]
        for i in range(n):
            self.__data[i][i] = 1
        return self
    def tampilan(self):
        print(f"Matriks {self.__baris} x {self.__kolom}:")
        for i in range(self.__baris):
            print(end="")
            for j in range(self.__kolom):
                print(f"{self.__data[i][j]:4}", end=" ")
            print()
        print()


nol = Matriks()
nol.Nol(2, 4)
nol.tampilan()

baris = Matriks()
baris.Baris([5, -3, 8])
baris.tampilan()

kolom = Matriks()
kolom.Kolom([4, 7, 2])
kolom.tampilan()

persegi = Matriks()
persegi.Persegi(2)
persegi.data = [[3, -1], [6, 2]]
persegi.tampilan()

diagonal = Matriks()
diagonal.Diagonal([5, 1, 9])
diagonal.tampilan()

atas = Matriks()
atas.SegitigaAtas(3)
atas.tampilan()

bawah = Matriks()
bawah.SegitigaBawah(3)
bawah.tampilan()

identitas = Matriks()
identitas.Identitas(3)
identitas.tampilan()

print("baris:", identitas.baris)
print("kolom:", identitas.kolom)
