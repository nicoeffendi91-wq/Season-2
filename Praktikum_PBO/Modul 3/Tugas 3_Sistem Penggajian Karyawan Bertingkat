print("ID Karyawan :", manajer.id_karyawan)
print("Departemen  :", manajer.departemen)
print("Gaji Dasar  : Rp", manajer.gaji_dasar)
print("Tunjangan   : Rp", manajer.tunjangan)
print("Total Gaji  : Rp", manajer.total_salary())
print()
